{
  "name": "affiliate-automation",
  "version": "1.0.0",
  "description": "Sistema de automação de afiliados multi-canal (Telegram -> WhatsApp)",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "servidor": "node src/servidor.js",
    "check": "for f in src/*.js src/affiliates/*.js src/canais/*.js src/midia/*.js src/publicacao/*.js scripts/*.mjs; do node --check $f; done",
    "verify": "npm run check && npm test",
    "verify:links": "node scripts/verificar-links.mjs",
    "verify:ig": "node scripts/verificar-ig.mjs",
    "verify:api": "npm run verify:links && npm run verify:ig",
    "ensaiar": "node scripts/ensaiar-story.mjs",
    "publicar": "node scripts/publicar-story.mjs",
    "publicar:feed": "node scripts/publicar-feed.mjs",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "recompor": "node scripts/recompor-acervo.mjs",
    "status": "node src/status.js",
    "doctor": "node src/app.js --doctor",
    "diag:midia": "node src/app.js --diag-midia",
    "test": "node --test",
    "reset-sessao": "rm -rf tokens"
  },
  "dependencies": {
    "@wppconnect-team/wppconnect": "2.3.3",
    "@wppconnect/wa-js": "4.6.0",
    "axios": "^1.7.4",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "telegram": "^2.26.3"
  },
  "overrides": {
    "@wppconnect/wa-js": "4.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
