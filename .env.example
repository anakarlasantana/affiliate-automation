# ============ Telegram (obtido em https://my.telegram.org) ============
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Gerada no primeiro login do Telegram pelo script (será impressa no console)
TELEGRAM_SESSION_STRING=

# ============ Credenciais de Afiliados ============
# Shopee Open Platform (https://open.shopee.com)
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Marca d'água (subId) dos seus short links da Shopee (opcional, default: hi-cleo)
SHOPEE_SUB_ID=
# Amazon Associates (sua tag, ex: minhatag-20)
AMAZON_TAG=
# Magalu Parceiro (slug da sua loja, ex: minhaloja)
MAGALU_STORE_ID=
# Mercado Livre Afiliados (ID/tracking do painel)
MELI_AFFILIATE_ID=
# Slug da SUA vitrine Meli: se seu link é mercadolivre.com.br/social/minhaloja, use "minhaloja"
# (opcional — links /social/ de outros afiliados só são repassados apontando para a sua vitrine;
#  sem ela, ofertas de vitrine de terceiros são descartadas)
MELI_SOCIAL_ID=
# Shein Afiliados
SHEIN_AFFILIATE_ID=
# TikTok Shop Afiliados
TIKTOKSHOP_AFFILIATE_ID=

# ============ Afiliados genéricos (futuras lojas, sem código novo) ============
# Formato: dominio.com:parametro:sua_chave
# AFFILIATE_GENERIC_1=aliexpress.com:aff_fcid:MEU_ID
AFFILIATE_GENERIC_1=
AFFILIATE_GENERIC_2=
AFFILIATE_GENERIC_3=

# ============ Anti-ban / ritmo de envios ============
# Limite de ofertas por dia (0 = sem limite)
MAX_ENVIOS_DIA=150
# Janelas quentes de compra (pico de conversão no e-commerce BR)
HORAS_QUENTES=12-14,19-22
# Madrugada (envios quase congelados)
HORAS_SILENCIO=0-7
# Delays em segundos "min,max" por faixa de horário
DELAY_QUENTE=5,15
DELAY_NORMAL=45,120
DELAY_FRIO=180,420

# ============ Canais / Grupos ============
MEU_GRUPO_WHATSAPP=
# Link de convite do seu grupo (divulgado no rodape das ofertas)
MEU_GRUPO_LINK=
CANAIS_TELEGRAM_MONITORADOS=achadinhos,promobit_oficial
GRUPOS_WHATSAPP_MONITORADOS=123456789@g.us,987654321@g.us

# ---- Boot resiliente do WhatsApp (usados pelo app.js) ----
# Nome da sessao = pasta criada dentro de tokens/
WPP_SESSAO=affiliate-automation
# Versao do WhatsApp Web: 'auto' fixa a mais recente embutida no wppconnect
# (recomendado: sem isso o WhatsApp cai para a versao live e a injecao falha)
WHATSAPP_WEB_VERSION=auto
# Segundos esperando o QR ser escaneado (0 = nunca fecha)
WPP_TIMEOUT_QR=300
# Segundos maximos aguardando a sincronizacao do dispositivo;
# com backlog de dias o padrao do wppconnect (180s) mata o boot no meio
WPP_DEVICE_SYNC_TIMEOUT=900
# Tentativas de conexao antes de desistir
WPP_TENTATIVAS=3
# Chrome/Chromium do sistema. No arm64 (Oracle Ampere A1) o Chrome oficial nao
# existe — instale o Chromium do apt e aponte aqui (vazio = detecta sozinho)
#CHROME_PATH=/usr/bin/chromium
# Fuso das janelas de envio e da virada do dia. Em VPS (UTC) sem isso o
# anti-ban dispararia na madrugada errada
TZ_OPERACAO=America/Sao_Paulo

# ---- Diagnostico de midia (foto do grupo chegando como miniatura) ----
# Em mensagem com foto, o `msg.body` do wppconnect carrega o jpegThumbnail do
# WhatsApp (72x72, ~1,5-2,5 KB) — nao a foto. O app agora mede a DIMENSAO
# (src/imagem.js: MIN_LADO_FOTO = 300px, lado maior) e, se for miniatura, baixa
# a foto original via downloadMedia. Bytes NAO servem de criterio: um og:image
# legitimo tem 15 KB, menos que muitos thumbnails.
#
# DIAG_MIDIA=1 -> modo diagnostico: conecta, escuta e imprime o payload cru de
#   cada foto (body x downloadMedia, com dimensoes e KB) e a fila NAO envia
#   nada. Use para investigar de onde vem a imagem publicada.
#DIAG_MIDIA=1

# Quantas mensagens varrer por grupo no `npm run diag:midia` (historico)
#DIAG_MIDIA_LIMITE=10

# ---- Reservados (nao lidos pelo codigo hoje) ----
# A re-hidratacao da midia e imediata no proprio listener (getMessageById +
# downloadMedia), sem fila de espera — por isso estas chaves ficam inertes.
#MAX_TENTATIVAS_ITEM=3
#ESPERA_MIDIA_MIN=20
#ESPERA_MIDIA_INTERVALO_SEG=120
